    {
      "description": "la demande des cases accessibles du pion e2",
      "pending": false,
      "providerStates": [
        {
          "name": "aucun joueur n’est connecté"
        }
      ],
      "request": {
        "body": {
          "content": {
            "fen": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
            "from": "e2"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ],
          "X-XSRF-TOKEN": [
            "jeton-csrf-de-test"
          ]
        },
        "matchingRules": {
          "header": {
            "X-XSRF-TOKEN": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/api/games/echecs/destinations"
      },
      "response": {
        "body": {
          "content": {
            "destinations": [
              "e3"
            ]
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.destinations": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "la lecture de la session d’un joueur connecté",
      "pending": false,
      "providerStates": [
        {
          "name": "un joueur est connecté"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/auth/session"
      },
      "response": {
        "body": {
          "content": {
            "accessToken": "eyJhbGciOiJIUzI1NiJ9.e30.signature",
            "expiresAt": 1793000000000,
            "user": {
              "email": "joueur@example.com",
              "id": "7c9e6679-7425-40de-944b-e07fc1f90ae7"
            }
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.accessToken": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.expiresAt": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.user.email": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.user.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^[0-9a-f-]{36}$"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "la lecture de la session d’un visiteur",
