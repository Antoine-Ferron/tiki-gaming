# Copier en `.env` à la racine pour tester le déploiement Docker Compose en local (`docker compose up`),
# ou renseigner les mêmes clés dans Coolify (resource > Environment Variables). Ne jamais commiter `.env`.

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<client-secret>

# Supabase > Project Settings > API (et JWT Keys pour le secret)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_JWT_SECRET=<legacy-jwt-secret>

# URL publique du front : le domaine généré par Coolify pour le service `frontend` (ou le domaine
# personnalisé configuré dessus). Sert au callback Google et aux redirections après connexion.
FRONTEND_URL=https://<domaine-front>
