{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd backend && mvn -q spring-boot:run"],
      "port": 8080,
      "autoPort": false
    },
    {
      "name": "web",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "npm --prefix frontend run dev -- --port ${PORT:-5173} --strictPort"],
      "port": 5173,
      "autoPort": true
    }
  ]
}
