# Copier ce fichier en .env puis renseigner les valeurs (Dashboard Supabase > Project Settings > API).
# Seules les variables préfixées VITE_ sont exposées au navigateur : n'y mettez JAMAIS la clé service_role.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# --- Outillage local uniquement (scripts/db.mjs) — JAMAIS de préfixe VITE_ ---
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_DB_PASSWORD=<database-password>
# SUPABASE_DB_HOST=aws-0-eu-west-1.pooler.supabase.com   # optionnel
