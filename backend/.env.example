# Copier en backend/.env (ignoré par git). Ces valeurs restent côté serveur.

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<client-secret>

# Supabase > Project Settings > API (et JWT Keys pour le secret)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_JWT_SECRET=<legacy-jwt-secret>

# URL publique du front (callback Google + redirections après connexion)
FRONTEND_URL=http://localhost:5173
# true en production (HTTPS)
COOKIE_SECURE=false
# Swagger UI (/swagger-ui.html) et /v3/api-docs : false en production
SWAGGER_ENABLED=true
